# The origin this deployment serves from. Used for canonical tags, OG images, the sitemap and every
# absolute URL the agent surfaces publish (`/llms.txt`, `/skill.md`, `/mcp`).
#
# On Vercel this can be left unset — `PUBLIC_VERCEL_URL` is used instead — but a production
# deployment should pin it to the custom domain so previews do not become canonical.
PUBLIC_APP_URL=https://your-domain.example

# Optional Axiom ingest for registry-install and markdown-fetch events. With either value missing,
# the analytics path is a no-op and no request is made.
AXIOM_TOKEN=
AXIOM_DATASET=
