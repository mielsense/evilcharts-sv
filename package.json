{
	"name": "evilcharts-svelte",
	"version": "0.0.1",
	"description": "Animated, interactive Svelte 5 chart components on LayerChart. An unofficial Svelte port of EvilCharts.",
	"license": "MIT",
	"homepage": "https://evilcharts-sv.vercel.app",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mielsense/evilcharts-sv.git"
	},
	"bugs": {
		"url": "https://github.com/mielsense/evilcharts-sv/issues"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "npm run registry:fresh && vite build && npm run prepack",
		"registry:build": "tsx scripts/build-registry.ts",
		"registry:clean": "rm -rf static/r registry.json src/lib/registry/__index__.ts",
		"registry:fresh": "npm run registry:clean && npm run registry:build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e:install": "playwright install",
		"test:e2e": "playwright test",
		"test:runtime": "playwright test --config playwright.runtime.config.ts"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^9.39.5",
		"@playwright/test": "^1.60.0",
		"@shikijs/transformers": "^4.4.3",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"github-slugger": "^2.0.0",
		"globals": "^17.6.0",
		"mdsvex": "^0.12.8",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"publint": "^0.3.21",
		"shiki": "^4.4.3",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.23.12",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"unist-util-visit": "^5.1.0",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"keywords": [
		"svelte"
	],
	"dependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@humanspeak/svelte-motion": "^0.9.4",
		"@lucide/svelte": "^1.33.0",
		"@number-flow/svelte": "^0.4.2",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.2.0",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"layerchart": "^2.3.0",
		"mode-watcher": "^1.1.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tw-animate-css": "^1.4.0"
	}
}
